# Reference only: this file is NOT loaded automatically. Supply environment variables explicitly.
# No actual credentials, company data, host inventory or operational paths belong here.
APP_ENV=development
APP_ALLOWED_HOSTS=127.0.0.1,localhost
APP_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8870,http://localhost:8870
DJANGO_SECRET_KEY_FILE=/absolute/private/django-key
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=synthetic
DATABASE_USER=synthetic
DATABASE_PASSWORD_FILE=/absolute/private/db-password
DATABASE_SSLMODE=disable
PRIVATE_MEDIA_ROOT=/absolute/private/media
# Optional future integrations; not connected by SM02:
# REDIS_URL_FILE=/absolute/private/redis-url
# PUBLIC_BID_POLICY_SOURCE_FILE=/absolute/private/policy-source.json
