    "/auth/change-password": {
      "post": {
        "operationId": "auth_change_password",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Safe error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "current_password": {
                    "type": "string",
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "new_password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 128,
                    "writeOnly": true
                  },
                  "expected_auth_epoch": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "current_password",
                  "new_password",
                  "expected_auth_epoch"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRFToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Atomic password/epoch/audit update, all sessions invalidated, 204 requires login. Lost response requires checking session state; never automatically resend passwords."
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "security": [],
        "responses": {
          "204": {
            "description": "Success"
