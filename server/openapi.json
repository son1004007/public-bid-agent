  },
  "components": {
    "schemas": {
      "RequestId": {
        "type": "string",
        "format": "uuid"
      },
      "SingleResponse": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {},
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "PageResponse": {
        "type": "object",
        "required": [
          "data",
          "page",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {}
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        },
        "additionalProperties": false
      },
      "Page": {
        "type": "object",
        "required": [
          "next_cursor",
          "total"
        ],
        "properties": {
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "total": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "fields",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "data": {
            "type": "object",
            "required": [
              "status",
              "scope"
            ],
            "properties": {
              "status": {
                "const": "ok"
              },
              "scope": {
                "const": "process"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "AuthUser": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "capabilities"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "review",
                "decide",
                "manage_accounts",
                "manage_connections"
              ]
            }
          }
        }
      },
      "SessionData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user",
          "access",
          "auth_epoch"
        ],
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUser"
          },
          "access": {
            "enum": [
              "FULL",
              "PASSWORD_CHANGE_REQUIRED"
            ]
          },
          "auth_epoch": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/SessionData"
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "request_id"
        ],
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "csrf_token"
            ],
            "properties": {
              "csrf_token": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  }
}
