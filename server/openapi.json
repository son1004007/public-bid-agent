{
  "openapi": "3.1.0",
  "info": {
    "title": "Public Bid Agent isolated foundation",
    "version": "0.2.0",
    "description": "Isolated SM02 foundation and SM03 DB session authentication. No production migration or business endpoints."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "processHealth",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Process liveness only. No DB, broker, auth or provider readiness claim.",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or disallowed host",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "405": {
            "description": "Unsupported method",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "406": {
            "description": "Unsupported response type",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds boundary limit",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Safe internal error",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "PASSWORD_CHANGE_REQUIRED for restricted authenticated sessions"
          }
        }
      },
      "head": {
        "operationId": "processHealthHead",
        "security": [],
        "responses": {
          "200": {
            "description": "Liveness headers, no body",
            "headers": {
              "X-Request-ID": {
                "description": "Server-generated UUID. Client value is ignored.",
                "schema": {
                  "$ref": "#/components/schemas/RequestId"
                }
              }
            }
          }
        }
      }
    },
