        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "username": {
                    "type": "string",
                    "maxLength": 150
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 128,
                    "writeOnly": true
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRFToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
