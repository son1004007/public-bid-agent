            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRFToken",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "CSRF required, including anonymous idempotent logout. No secret/result cache."
      }
